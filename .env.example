# ──────────────────────────────────────────────────────────────────────────────
# Configurazione DIADEMA / Girder – variabili d'ambiente
# ──────────────────────────────────────────────────────────────────────────────
# Copia questo file in .env e compila i valori prima di avviare docker-compose:
#
#   cp .env.example .env
#   # modifica .env con i tuoi valori
#   docker-compose up -d
#
# IMPORTANTE: .env è nel .gitignore e NON deve mai essere versionato.
# ──────────────────────────────────────────────────────────────────────────────

# ── Credenziali RabbitMQ ──────────────────────────────────────────────────────
# Cambiale in produzione! Evitare le password di default.
RABBITMQ_USER=girder
RABBITMQ_PASS=changeme_in_production

# ── Directory di output DIADEMA sui worker ────────────────────────────────────
# Queste directory devono corrispondere ai mount point dei volumi Docker.
# In alternativa, configura le stesse directory nelle Settings admin del plugin.
DIADEMA_MRIQC_OUTPUT_DIR=/data/diadema/mriqc
DIADEMA_SUBJECTS_DIR=/data/diadema/subjects
DIADEMA_LSTAI_OUTPUT_DIR=/data/diadema/lstai

# ── (Opzionale) Override dell'URL Girder per i worker ────────────────────────
# Lascia vuoto per usare il default http://girder:8080/api/v1
# GIRDER_API_URL=http://girder:8080/api/v1
