# ═══════════════════════════════════════════════════════════════════
# DIADEMA – Full stack (Girder + Nginx + workers)
# ═══════════════════════════════════════════════════════════════════
# Copia questo file come .env e personalizza i valori:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────
RABBITMQ_USER=girder
RABBITMQ_PASS=changeme_rabbitmq

# ──────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────
MONGO_DB=girder

# ──────────────────────────────────────────
# Girder
# ──────────────────────────────────────────
GIRDER_ADMIN_LOGIN=admin
GIRDER_ADMIN_PASSWORD=changeme_admin
GIRDER_ADMIN_EMAIL=admin@example.com
GIRDER_ADMIN_FIRST_NAME=Admin
GIRDER_ADMIN_LAST_NAME=User
GIRDER_ADMIN_RESET_PASSWORD=false

GIRDER_ASSETSTORE_PATH=/data/assetstore
GIRDER_ASSETSTORE_NAME=Primary Assetstore
GIRDER_BRAND_NAME=DIADEMA
GIRDER_REGISTRATION_POLICY=closed
GIRDER_EMAIL_VERIFICATION=disabled
GIRDER_ENABLE_PASSWORD_LOGIN=true

# ──────────────────────────────────────────
# Nginx / TLS
# ──────────────────────────────────────────
# Porta HTTP dell'host (reindirizza automaticamente a HTTPS)
NGINX_PORT=80
# Porta HTTPS dell'host: entry point cifrato per browser e job
NGINX_HTTPS_PORT=443
# Hostname pubblico con cui si raggiunge lo stack: entra nel SAN del certificato
# self-signed generato al primo avvio (servizio init-certs). Impostalo al dominio
# reale in produzione (es. diadema.example.org).
DIADEMA_PUBLIC_HOST=localhost
# NOTA: il certificato è firmato da una CA interna self-signed (volume `certs`).
# I browser mostreranno un warning finché non importi /etc/nginx/certs/ca.crt
# (estraibile con: docker compose cp nginx:/etc/nginx/certs/ca.crt ./ca.crt)
# nel trust store del sistema/client. La verifica TLS interna dei job usa già
# questa CA via REQUESTS_CA_BUNDLE.

# ──────────────────────────────────────────
# DIADEMA – MRIQC worker
# ──────────────────────────────────────────
DIADEMA_MRIQC_OUTPUT_DIR=/data/diadema/mriqc

# ──────────────────────────────────────────
# DIADEMA – FreeSurfer worker
# ──────────────────────────────────────────
DIADEMA_SUBJECTS_DIR=/data/diadema/subjects
FREESURFER_LICENSE_PATH=./freesurfer_license.txt

# ──────────────────────────────────────────
# Porte diagnostica
# ──────────────────────────────────────────
RABBITMQ_MGMT_PORT=15672
