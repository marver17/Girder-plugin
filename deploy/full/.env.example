# ═══════════════════════════════════════════════════════════════════
# DIADEMA – Full stack (Girder + Nginx + workers)
# ═══════════════════════════════════════════════════════════════════
# Copia questo file come .env e personalizza i valori:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────
RABBITMQ_USER=girder
RABBITMQ_PASS=changeme_rabbitmq

# Utente dedicato ai worker remoti (cluster K8s su altra rete),
# raggiungibile solo via AMQPS attraverso il tunnel WireGuard, sullo
# stesso vhost "/" dei worker locali ma con permessi ristretti via regex
# alle sole code offloadate da remoto — vedi deploy/full/docker-compose.yml
# (init-rabbitmq-remote) e deploy/k8s-remote-worker/. Porta AMQPS esposta
# sull'host ma da firewallare per accettare solo dall'interfaccia/subnet
# del tunnel WireGuard, mai da Internet in generale.
RABBITMQ_AMQPS_PORT=5671
REMOTE_WORKER_USER=remote-worker
REMOTE_WORKER_PASS=changeme_remote_worker
REMOTE_WORKER_QUEUES_REGEX=^(diadema_mriqc|freesurfer)$

# ──────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────
MONGO_DB=girder

# ──────────────────────────────────────────
# Girder
# ──────────────────────────────────────────
GIRDER_ADMIN_LOGIN=admin
GIRDER_ADMIN_PASSWORD=changeme_admin
GIRDER_ADMIN_EMAIL=admin@example.com
GIRDER_ADMIN_FIRST_NAME=Admin
GIRDER_ADMIN_LAST_NAME=User
GIRDER_ADMIN_RESET_PASSWORD=false

GIRDER_ASSETSTORE_PATH=/data/assetstore
GIRDER_ASSETSTORE_NAME=Primary Assetstore
GIRDER_BRAND_NAME=DIADEMA
GIRDER_REGISTRATION_POLICY=closed
GIRDER_EMAIL_VERIFICATION=disabled
GIRDER_ENABLE_PASSWORD_LOGIN=true

# ──────────────────────────────────────────
# Nginx / TLS
# ──────────────────────────────────────────
# Porta HTTP dell'host (reindirizza automaticamente a HTTPS)
NGINX_PORT=80
# Porta HTTPS dell'host: entry point cifrato per browser e job
NGINX_HTTPS_PORT=443
# Hostname pubblico con cui si raggiunge lo stack: entra nel SAN del certificato
# self-signed generato al primo avvio (servizio init-certs). Impostalo al dominio
# reale in produzione (es. diadema.example.org).
DIADEMA_PUBLIC_HOST=localhost
# SAN aggiuntivi (DNS, separati da virgola) per il certificato server, oltre
# a nginx/localhost/DIADEMA_PUBLIC_HOST/127.0.0.1. Serve al worker remoto per
# validare via TLS l'hostname del Service K8s del gateway WireGuard a cui si
# connette per AMQPS/HTTPS — vedi deploy/k8s-remote-worker/.
DIADEMA_EXTRA_SAN=wireguard-gateway.diadema-remote.svc.cluster.local
# NOTA: il certificato è firmato da una CA interna self-signed (volume `certs`).
# I browser mostreranno un warning finché non importi /etc/nginx/certs/ca.crt
# (estraibile con: docker compose cp nginx:/etc/nginx/certs/ca.crt ./ca.crt)
# nel trust store del sistema/client. La verifica TLS interna dei job usa già
# questa CA via REQUESTS_CA_BUNDLE.

# ──────────────────────────────────────────
# Gateway WireGuard verso il cluster K8s remoto
# ──────────────────────────────────────────
# Chiavi generate una tantum (`wg genkey | tee privkey | wg pubkey > pubkey`),
# MAI committate: valorizzare solo nel proprio .env locale, fuori da git.
WG_PRIVATE_KEY=
# Chiave pubblica del gateway lato cluster K8s (deploy/k8s-remote-worker/wireguard-gateway.yaml)
WG_PEER_PUBLIC_KEY=
# IP fisso del cluster remoto + porta NodePort UDP pubblicata per il gateway
# (vedi deploy/k8s-remote-worker/wireguard-gateway.yaml, Service NodePort)
WG_PEER_ENDPOINT=<CLUSTER_PUBLIC_IP>:30820
WG_ADDRESS=10.90.0.1/24
WG_PEER_ALLOWED_IPS=10.90.0.2/32
WG_LISTEN_PORT=51820

# ──────────────────────────────────────────
# DIADEMA – MRIQC worker
# ──────────────────────────────────────────
DIADEMA_MRIQC_OUTPUT_DIR=/data/diadema/mriqc

# ──────────────────────────────────────────
# DIADEMA – FreeSurfer worker
# ──────────────────────────────────────────
DIADEMA_SUBJECTS_DIR=/data/diadema/subjects
FREESURFER_LICENSE_PATH=./freesurfer_license.txt

# ──────────────────────────────────────────
# Porte diagnostica
# ──────────────────────────────────────────
RABBITMQ_MGMT_PORT=15672
