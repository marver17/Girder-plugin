# ═══════════════════════════════════════════════════════════════════
# DIADEMA – Configurazione ambiente testing (simil-produzione)
# ═══════════════════════════════════════════════════════════════════
# Copia questo file come .env e personalizza i valori:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────
RABBITMQ_USER=girder
RABBITMQ_PASS=changeme_rabbitmq

# ──────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────
# In questa configurazione MongoDB non richiede autenticazione.
# Per abilitarla aggiungere MONGO_INITDB_ROOT_USERNAME/PASSWORD
# e aggiornare GIRDER_MONGO_URI di conseguenza.
MONGO_DB=girder

# ──────────────────────────────────────────
# Girder
# ──────────────────────────────────────────
# Porta esposta sull'host
GIRDER_PORT=8080

# ──────────────────────────────────────────
# Girder Bootstrap (bootstrap_girder.py)
# ──────────────────────────────────────────
# Utente admin creato al primo avvio (idempotente).
# Cambiate login e password in ambienti non di sviluppo!
GIRDER_ADMIN_LOGIN=admin
GIRDER_ADMIN_PASSWORD=changeme_admin
GIRDER_ADMIN_EMAIL=admin@example.com
GIRDER_ADMIN_FIRST_NAME=Admin
GIRDER_ADMIN_LAST_NAME=User
# Imposta a true per sovrascrivere la password ad ogni riavvio
GIRDER_ADMIN_RESET_PASSWORD=false

# Assetstore filesystem (deve corrispondere al volume Docker)
GIRDER_ASSETSTORE_PATH=/data/assetstore
GIRDER_ASSETSTORE_NAME=Primary Assetstore

# Impostazioni brand e sicurezza
GIRDER_BRAND_NAME=DIADEMA
GIRDER_REGISTRATION_POLICY=closed
GIRDER_EMAIL_VERIFICATION=disabled
GIRDER_ENABLE_PASSWORD_LOGIN=true

# ──────────────────────────────────────────
# DIADEMA – MRIQC worker
# ──────────────────────────────────────────
# Directory host dove scrivere i risultati MRIQC (persistente fuori dai container)
DIADEMA_MRIQC_OUTPUT_DIR=/data/diadema/mriqc

# ──────────────────────────────────────────
# DIADEMA – FreeSurfer worker
# ──────────────────────────────────────────
# Directory host dove scrivere i soggetti FreeSurfer (può essere molto grande)
DIADEMA_SUBJECTS_DIR=/data/diadema/subjects

# Percorso della licenza FreeSurfer sull'HOST (verrà montata nel container).
# Ottenere la licenza gratuita su: https://surfer.nmr.mgh.harvard.edu/registration.html
FREESURFER_LICENSE_PATH=./freesurfer_license.txt

# ──────────────────────────────────────────
# Porte per diagnostica e admin UI
# ──────────────────────────────────────────
# RabbitMQ Management UI (http://localhost:RABBITMQ_MGMT_PORT)
RABBITMQ_MGMT_PORT=15672
