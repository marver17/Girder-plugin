{
  "name": "@girder/plugin-template",
  "version": "0.1.0",
  "description": "Plugin Template web client",
  "type": "module",
  "files": ["dist", "package.json"],
  "main": "./dist/plugin-template.umd.cjs",
  "module": "./dist/plugin-template.js",
  "exports": {
    ".": {
